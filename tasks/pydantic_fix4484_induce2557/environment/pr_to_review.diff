+
+    class Model(pydantic.BaseModel, post_init_call='after_validation'):
+        set_wrapper: SetWrapper
+
+    model = Model(set_wrapper=SetWrapper({1, 2, 3}))
+    json_text = model.json()
+    assert Model.parse_raw(json_text) == model
