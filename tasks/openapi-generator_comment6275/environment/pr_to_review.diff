+                    triangle_type="EquilateralTriangle"
+                ),
+                petstore_api.Triangle(
+                    shape_type="Triangle",
+                    triangle_type="IsoscelesTriangle"
+                ),
+                petstore_api.EquilateralTriangle(
+                    shape_type="Triangle",
+                    triangle_type="EquilateralTriangle"
+                ),
