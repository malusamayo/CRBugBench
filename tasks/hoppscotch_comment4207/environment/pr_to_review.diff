diff --git a/packages/hoppscotch-backend/src/team-collection/team-collection.service.ts b/packages/hoppscotch-backend/src/team-collection/team-collection.service.ts
index b8af9de9270..b73a9cd0599 100644
--- a/packages/hoppscotch-backend/src/team-collection/team-collection.service.ts
