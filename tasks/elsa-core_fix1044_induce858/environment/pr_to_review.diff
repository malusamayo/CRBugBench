+                app.UseHsts();
+            }
+
+            app.UseHttpsRedirection();
+            app.UseStaticFiles();
+            app.UseHttpActivities();
+            app.UseRouting();
+            app.UseAuthorization();
+            app.UseEndpoints(endpoints =>
+            {
+                // Elsa Server uses ASP.NET Core Controllers.
+                endpoints.MapControllers();
+                
+                endpoints.MapFallbackToPage("/_Host");
+            });
+        }
