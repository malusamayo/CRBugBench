+                    resourceType,
+                    obj.Metadata.Name,
+                    cancellationToken: cancellationToken).ConfigureAwait(false)
+                : await kubernetes.CustomObjects.PatchNamespacedCustomObjectWithHttpMessagesAsync(
+                    patch,
+                    GroupVersion.Group,
+                    GroupVersion.Version,
+                    namespaceParameter,
+                    resourceType,
+                    obj.Metadata.Name,
+                    cancellationToken: cancellationToken).ConfigureAwait(false);
