+    public Task<T> PatchAsync<T>(T obj, V1Patch patch, CancellationToken cancellationToken = default)
+        where T : CustomResource
+    {
+        ObjectDisposedException.ThrowIf(_disposed, this);
+        var resourceType = GetResourceFor<T>();
