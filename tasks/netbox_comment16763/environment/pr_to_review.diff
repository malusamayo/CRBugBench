+          </span>
+        </div>
+      </div>
+    </div>
+
+    <div class="card">
+      <div class="htmx-container table-responsive" id="object_list">
+        {% include 'htmx/table.html' %}
+      </div>
+    </div>
+
+  </div>
+{% endblock content %}
