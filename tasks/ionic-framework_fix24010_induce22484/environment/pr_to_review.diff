+     * @param buttons Optional - Array of buttons to be added to the alert
+     */
+    (message: string, buttons?: AlertButton[]): void;
+    /**
+     * Presents the alert
+     * @param options The options to pass to the IonAlert
+     */
+    (options: AlertOptions & HookOverlayOptions): void;
+  },
+  /**
