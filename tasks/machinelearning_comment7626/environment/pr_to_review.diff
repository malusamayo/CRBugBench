+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+// See the LICENSE file in the project root for more information.
+
+using System;
+using System.Collections.Concurrent;
+using System.Threading;
+using Microsoft.Extensions.ObjectPool;
+using Microsoft.ML;
+
+namespace Microsoft.Extensions.ML
+{
+    /// <summary>
+    /// An <see cref="ObjectPool{T}"/> of <see cref="PredictionEngine{TData, TPrediction}"/>
+    /// that owns the lifetime of the engines it hands out.
+    /// </summary>
+    internal sealed class DisposablePredictionEnginePool<TData, TPrediction>
+        : ObjectPool<PredictionEngine<TData, TPrediction>>, IDisposable
+        where TData : class
+        where TPrediction : class, new()
+    {
+        private readonly PredictionEnginePoolPolicy<TData, TPrediction> _policy;
+        private readonly ConcurrentQueue<PredictionEngine<TData, TPrediction>> _retained;
+        private readonly int _maximumRetained;
+        private int _retainedCount;
+        private volatile bool _disposed;
+
+        public DisposablePredictionEnginePool(PredictionEnginePoolPolicy<TData, TPrediction> policy, int maximumRetained)
+        {
+            _policy = policy ?? throw new ArgumentNullException(nameof(policy));
+            if (maximumRetained < 1)
+            {
+                throw new ArgumentOutOfRangeException(nameof(maximumRetained));
+            }
+
+            _maximumRetained = maximumRetained;
+            _retained = new ConcurrentQueue<PredictionEngine<TData, TPrediction>>();
+        }
+
+        public override PredictionEngine<TData, TPrediction> Get()
+        {
+            if (!_disposed && _retained.TryDequeue(out var engine))
+            {
+                Interlocked.Decrement(ref _retainedCount);
+                return engine;
+            }
+
+            return _policy.Create();
+        }
+
+        public override void Return(PredictionEngine<TData, TPrediction> obj)
+        {
+            if (obj == null)
+            {
+                return;
+            }
+
+            if (_disposed)
+            {
+                obj.Dispose();
+                return;
+            }
+
+            if (Interlocked.Increment(ref _retainedCount) <= _maximumRetained)
+            {
+                _retained.Enqueue(obj);
+
+                if (_disposed)
+                {
+                    DrainAndDispose();
+                }
+            }
+            else
+            {
+                Interlocked.Decrement(ref _retainedCount);
+                obj.Dispose();
+            }
+        }
+
+        public void Dispose()
+        {
+            if (_disposed)
+            {
+                return;
+            }
+
+            _disposed = true;
+            DrainAndDispose();
+        }
+
+        private void DrainAndDispose()
+        {
+            while (_retained.TryDequeue(out var engine))
+            {
+                Interlocked.Decrement(ref _retainedCount);
+                engine.Dispose();
+            }
+        }
+    }
+}
