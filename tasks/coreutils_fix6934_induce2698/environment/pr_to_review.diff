+        // minus zero float
+        assert_eq!(num_fractional_digits("-0.0"), 1);
+        assert_eq!(num_fractional_digits("-0e-1"), 1);
+        assert_eq!(num_fractional_digits("-0.0e-1"), 2);
+    }
