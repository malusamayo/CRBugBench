+
+        items = currentItems.join(",");
+      } else if ((currentItems.length + 1) == filterValues[name].length) {
+        items = ["all"];
+      } else {
+        currentItems.push(item);
+        items = currentItems.join(",");
+      }
+    }
+
+    onFilter(name, items);
