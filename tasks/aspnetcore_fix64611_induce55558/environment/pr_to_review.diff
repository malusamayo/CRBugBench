+    private static string GetContentType(string filePath)
+    {
+        return Path.GetExtension(filePath) switch
+        {
+            ".txt" => "text/plain",
+            ".html" => "text/html",
+            ".css" => "text/css",
+            ".js" => "application/javascript",
+            ".json" => "application/json",
+            ".png" => "image/png",
+            ".jpg" => "image/jpeg",
+            ".jpeg" => "image/jpeg",
+            _ => "application/octet-stream"
+        };
+    }
