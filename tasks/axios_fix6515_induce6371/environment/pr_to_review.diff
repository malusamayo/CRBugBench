+
+    assert.strictEqual(data, 'OK');
+  });
+
+  describe('request aborting', function() {
+    it('should be able to abort the request stream', async function () {
+      server = await startHTTPServer({
+        rate: 100000,
+        useBuffering: true
+      });
+
+      const controller = new AbortController();
+
+      setTimeout(() => {
+        controller.abort();
+      }, 500);
