+		{
+			if (currentButton == ButtonsMask.Secondary)
+			{
+				return (recognizer.Buttons & ButtonsMask.Secondary) == ButtonsMask.Secondary;
+			}
+
+			return (recognizer.Buttons & ButtonsMask.Primary) == ButtonsMask.Primary;
