+    "LightOnOcrPreTrainedModel",
+    "LightOnOcrVisionModel",
+    "LightOnOcrTextModel",
+    "LightOnOcrTextPreTrainedModel",
+    "LightOnOcrForConditionalGeneration",
+    "LightOnOcrModel",
+]
