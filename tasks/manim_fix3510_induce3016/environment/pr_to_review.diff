+class LineJoints(Scene):
+    def construct(self):
+        t1 = Triangle()
+        t2 = Triangle(line_join=LineJointType.ROUND)
+        t3 = Triangle(line_join=LineJointType.BEVEL)
+
+        grp = VGroup(t1, t2, t3).arrange(RIGHT)
+        grp.set(width=config.frame_width - 1)
+
+        self.add(grp)
+
+
