+
+@dataclass
+class TypedDictTestcase:
+    impl: str
+    cls: type
+    expected_schema: core_schema.CoreSchema
+    total: bool
+
+
+TYPEDDICT_TESTCASES: List[TypedDictTestcase] = []
+
+
+for origin, base in (('typing', typing_TypedDict), ('typing_extensions', typing_extensions_TypedDict)):
+
+    class Total(base, total=True):
+        default: str
+        not_req: NotRequired[str]
+        req: Required[str]
+
+    total_schema = core_schema.typed_dict_schema(
+        fields={
+            'default': core_schema.typed_dict_field(schema=core_schema.str_schema(), required=True),
+            'not_req': core_schema.typed_dict_field(
+                schema=core_schema.str_schema(),
+                required=False,
+            ),
+            'req': core_schema.typed_dict_field(
+                schema=core_schema.str_schema(),
+                required=True,
+            ),
+        },
+        extra_behavior='forbid',
+    )
+
+    TYPEDDICT_TESTCASES.append(
+        TypedDictTestcase(origin, Total, total_schema, total=True),
+    )
+
+    class NotTotal(base, total=False):
+        default: str
+        not_req: NotRequired[str]
+        req: Required[str]
+
+    not_total_schema = core_schema.typed_dict_schema(
+        fields={
+            'default': core_schema.typed_dict_field(schema=core_schema.str_schema(), required=False),
+            'not_req': core_schema.typed_dict_field(
+                schema=core_schema.str_schema(),
+                required=False,
+            ),
+            'req': core_schema.typed_dict_field(
+                schema=core_schema.str_schema(),
+                required=True,
+            ),
+        },
+        extra_behavior='allow',
+    )
+    TYPEDDICT_TESTCASES.append(
+        TypedDictTestcase(origin, NotTotal, not_total_schema, total=False),
+    )
+
+
+@pytest.mark.parametrize('testcase', TYPEDDICT_TESTCASES, ids=lambda x: f'{x.impl}(total={x.total})')
+def test_typeddict_required_totality(testcase: TypedDictTestcase):
+    class MyModel(BaseModel):
+        x: testcase.cls
+
+    schema = MyModel.__pydantic_core_schema__['schema']['fields']['x']['schema']
+
+    fields_required = {(field, meta['required']) for field, meta in schema['fields'].items() if meta['required']}
+    expected_fields_required = {
+        (field, meta['required']) for field, meta in testcase.expected_schema['fields'].items() if meta['required']
+    }
+
+    assert fields_required == expected_fields_required
