+        {
+            Log.ReusedDescriptorSequence(_logger, serverComponent.Sequence, serverComponent.InvocationId.ToString("N"));
+            return false;
+        }
+
+        _seenSequenceNumbersForCurrentInvocation.Add(serverComponent.Sequence);
+        result = descriptor;
+        return true;
+    }
