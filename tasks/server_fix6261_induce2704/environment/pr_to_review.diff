+        sutProvider.GetDependency<IOrganizationDomainRepository>()
+            .GetClaimedDomainsByDomainNameAsync(orgDomain.DomainName)
+            .Returns(new List<OrganizationDomain>());
+        sutProvider.GetDependency<IOrganizationDomainRepository>()
