+const versionedObject = z.object({
+  v: z.number(),
+})
+
+export const HoppRESTRequestResponse = createVersionedEntity({
+  latestVersion: 0,
+  versionMap: {
+    0: V0_VERSION,
+  },
+  getVersion(data) {
