+/// An SNI value that is normalized (converted to lowercase)
+pub(crate) struct ServerNameNormalized(DnsName<'static>);
+
+impl Deref for ServerNameNormalized {
+    type Target = DnsName<'static>;
+
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+
+impl From<ServerNameNormalized> for DnsName<'static> {
+    fn from(server_name: ServerNameNormalized) -> Self {
+        server_name.0
+    }
+}
+
+impl<'a> TryFrom<&'a ServerNamePayload<'a>> for ServerNameNormalized {
+    type Error = ();
+
+    fn try_from(payload: &'a ServerNamePayload<'a>) -> Result<Self, Self::Error> {
+        match payload {
+            ServerNamePayload::SingleDnsName(dns_name) => Ok(Self(dns_name.to_lowercase_owned())),
+            ServerNamePayload::IpAddress => Err(()),
+            ServerNamePayload::Invalid => Err(()),
+        }
+    }
+}
