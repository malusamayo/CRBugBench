diff --git a/ui-ngx/src/app/modules/home/components/widget/lib/digital-gauge.ts b/ui-ngx/src/app/modules/home/components/widget/lib/digital-gauge.ts
new file mode 100644
index 0000000000..8a2b1188a7
--- /dev/null
+++ b/ui-ngx/src/app/modules/home/components/widget/lib/digital-gauge.ts
@@ -0,0 +1,214 @@
+///
