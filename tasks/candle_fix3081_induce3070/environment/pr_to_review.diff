+
+#[allow(clippy::too_many_arguments)]
+pub fn call_unary_contiguous(
+    device: &Device,
+    ep: impl EncoderProvider,
+    kernels: &Kernels,
+    kernel_name: contiguous::Kernel,
+    length: usize,
+    input: BufferOffset,
+    output: &Buffer,
