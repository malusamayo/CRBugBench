   <category id="CAT_GRAMMAIRE" name="Grammaire">
+
+      <rulegroup id="PLACE_DE_LA_VIRGULE" name="place de la virgule" default="temp_off">
+          <rule>
+              <pattern>
+                  <marker>
+                      <token postag="[RAVNJPZCD].*" postag_regexp="yes"/>
+                      <token>c'</token>
+                      <token>est</token>
+                  </marker>
+              </pattern>
+              <message>Une virgule semble être requise dans ce contexte.</message>
+              <suggestion>\1, \2\3</suggestion>
+              <example correction="grand, c'est">Le plus <marker>grand c'est</marker> Pierre.</example>
+          </rule>
+          <rule>
+              <pattern>
+                  <marker>
+                      <token postag="N.*" postag_regexp="yes"/>
+                      <token regexp="yes">ni|mais|car|or|c’est-à-dire|soit|voire|à savoir</token>
+                  </marker>
+              </pattern>
+              <message>Une virgule semble être requise dans ce contexte.</message>
+              <suggestion>\1, \2</suggestion>
+              <example correction="temps, mais">Il ne réagit pas au <marker>temps mais</marker> au lieu.</example>
+          </rule>
+          <rule>
+              <pattern>
+                  <marker>
+                      <token postag="V.*" postag_regexp="yes"/>
+                      <token postag="V.*" postag_regexp="yes"/>
+                      <token postag="R pers suj.*" postag_regexp="yes"/>
+                  </marker>
+              </pattern>
+              <message>Des virgules semblent être requises dans ce contexte.</message>
+              <suggestion>\1, \2\3,</suggestion>
+              <example correction="pense, dit-elle,">Il le <marker>pense dit-elle</marker> mais ce n'est pas vrai.</example>
+          </rule>
+          <rule>
+              <pattern>
+                  <marker>
+                      <token postag="N.*" postag_regexp="yes"/>
+                      <token postag="R pers suj.*" postag_regexp="yes"/>
+                  </marker>
+              </pattern>
+              <message>Une virgule semble être requise dans ce contexte.</message>
+              <suggestion>\1, \2</suggestion>
+              <example correction="photos, je">Ces <marker>photos je</marker> les aime beaucoup.</example>
+          </rule>
+      </rulegroup>
       <rule id="PLU_OU_PLUS" name="plu ou plus" default="temp_off">
           <pattern>
               <token postag="V.*" postag_regexp="yes"><exception postag="V avoir.*|V etre.*" postag_regexp="yes"/></token>
