+    pub fn matmul(&self, rhs: &Self) -> Result<Self> {
+        let a_dims = self.shape().dims();
+        let b_dims = rhs.shape().dims();
+
+        let dim = a_dims.len();
+
+        // if dim < 2 {
+        //     return Err(SmeltError::InsufficientRank { minimum_rank: 2 });
+        // }
+        if b_dims.len() != dim {
+            return Err(Error::ShapeMismatchBinaryOp {
+                lhs: self.shape().clone(),
+                rhs: rhs.shape().clone(),
+                op: "matmul",
+            });
+        }
+
+        let m = a_dims[dim - 2];
+        let k = a_dims[dim - 1];
+        let k2 = b_dims[dim - 2];
+        let n = b_dims[dim - 1];
+        if k != k2 {
+            return Err(Error::ShapeMismatchBinaryOp {
+                lhs: self.shape().clone(),
+                rhs: rhs.shape().clone(),
+                op: "matmul",
+            });
+        }
+
+        let mut c_shape: Vec<_> = a_dims[..dim - 2].into();
+        c_shape.extend(&[m, n]);
+        let c_shape: Shape = Shape(c_shape);
+        let batching: usize = a_dims[..dim - 2].iter().product();
+
+        let storage = self.storage.matmul_impl(
+            &rhs.storage,
+            (batching, m, n, k),
+            self.stride(),
+            rhs.stride(),
+        )?;
+        let tensor_ = Tensor_ {
+            id: TensorId::new(),
+            storage,
+            shape: c_shape.clone(),
+            stride: c_shape.stride_contiguous(),
+            op: Some(Op::Matmul(self.clone(), rhs.clone())),
+            is_variable: false,
+        };
+        Ok(Self(Arc::new(tensor_)))
+    }
